# Postgres (Neon, Supabase, Railway, RDS…). On Neon use the POOLED "-pooler"
# host here — it is the right one for a serverless app.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Only needed if you run `prisma migrate`: the UNPOOLED host, and uncomment
# directUrl in prisma/schema.prisma. `prisma db push` works without it.
# DIRECT_URL="postgresql://user:password@host-without-pooler/dbname?sslmode=require"

# Any long random string; `openssl rand -base64 32` is fine.
AUTH_SECRET="change-this-in-production-a-long-random-string-32chars-min"

APP_URL="http://localhost:3000"

# SMS gateway. Leave blank to run in simulation mode: messages are stored and
# shown in the app, but not delivered.
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""
